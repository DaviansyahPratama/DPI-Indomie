<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Gambar Ilustrasi / Logo -->
    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="Ilustrasi Onboarding"
        android:src="@drawable/ic_home"
        app:tint="@color/primary_orange" />

    <!-- Judul Slide -->
    <TextView
        android:id="@+id/tvTitleOnboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Monitoring Real-Time"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Deskripsi Slide -->
    <TextView
        android:id="@+id/tvDescOnboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Pantau suhu oven, kelembaban, dan laju produksi lini pabrik Rengginang Sabit secara real-time."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
