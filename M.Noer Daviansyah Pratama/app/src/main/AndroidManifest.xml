<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uranus_Dapi">

        <!-- SplashActivity sebagai LAUNCHER (Titik Awal Aplikasi) -->
        <activity
            android:name=".splash.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard / Home -->
        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Monitoring -->
        <activity
            android:name=".monitoring.MonitoringActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".monitoring.DetailDataActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Orders -->
        <activity
            android:name=".orders.OrdersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reports -->
        <activity
            android:name=".reports.ReportsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile -->
        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>